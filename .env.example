# === Untuk Docker (docker compose baca file .env di folder ini) ===
# Rahasia JWT — WAJIB acak & panjang untuk deploy publik. Buat dengan:
#   openssl rand -hex 32
JWT_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"

# Password DB (opsional, default poscafe_secret). DB tidak diekspos ke publik.
POSTGRES_PASSWORD="poscafe_secret"

# Set 1 kalau diakses via HTTPS (di belakang Nginx Proxy Manager / reverse proxy).
COOKIE_SECURE="0"

# Password awal admin & kasir (dipakai HANYA saat instalasi baru / DB kosong).
# Untuk publik, isi yang kuat lalu jangan pakai default admin123/kasir123.
ADMIN_PASSWORD=""
KASIR_PASSWORD=""

# === Untuk pengembangan lokal (npm run dev, tanpa Docker) ===
DATABASE_URL="postgresql://poscafe:poscafe_secret@localhost:5432/poscafe?schema=public"
TZ="Asia/Jakarta"
