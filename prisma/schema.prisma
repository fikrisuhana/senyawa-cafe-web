generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KASIR
  BELANJA // staf belanja: cuma catat belanja (+ tambah stok) & absen diri sendiri
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  password     String
  role         Role          @default(KASIR)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model MenuItem {
  id            String         @id @default(cuid())
  name          String         @unique
  category      String         @default("LAINNYA")
  price         Int            @default(0)
  cost          Int            @default(0) // modal (opsional, untuk hitung untung)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  stocks        MenuStock[] // bahan/kemasan yang dipakai (bisa lebih dari satu)
  variantGroups VariantGroup[]
  updatedAt     DateTime       @updatedAt

  @@index([category])
}

// Grup pilihan menu, mis. "Suhu" (Panas/Dingin) atau "Extra" (Double shot).
model VariantGroup {
  id         String          @id @default(cuid())
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  type       String          @default("SINGLE") // SINGLE (pilih satu) | MULTI (boleh banyak)
  required   Boolean         @default(false)
  sortOrder  Int             @default(0)
  options    VariantOption[]
}

model VariantOption {
  id         String               @id @default(cuid())
  group      VariantGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  name       String
  priceDelta Int                  @default(0) // tambahan harga (mis. Double shot +5000)
  sortOrder  Int                  @default(0)
  stocks     VariantOptionStock[] // bahan/kemasan khusus opsi ini (mis. Dingin → cup plastik)
}

// Bahan/kemasan yang dipotong ketika sebuah opsi varian dipilih.
model VariantOptionStock {
  id          String        @id @default(cuid())
  option      VariantOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId    String
  packaging   Packaging     @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  packagingId String
  qty         Int           @default(1)

  @@unique([optionId, packagingId])
}

// Bahan/stok yang dihitung: kemasan (cup, wadah) ATAU bahan (mie, dll).
model Packaging {
  id           String               @id @default(cuid())
  name         String               @unique
  unit         String               @default("pcs") // SATUAN DASAR (terkecil): ml/gram/pcs
  // Satuan BELI + konversi: susu beli "liter" faktor 1000 → input 2 liter = +2000 ml.
  buyUnit      String?
  buyFactor    Int                  @default(1)
  stock        Int                  @default(0)
  minStock     Int                  @default(0)
  updatedAt    DateTime             @updatedAt
  menuStocks   MenuStock[]
  optionStocks VariantOptionStock[]
  movements    StockMovement[]
}

// Satu bahan yang dipakai sebuah menu, dengan qty per porsi. (Mie = Mie×1 + Wadah×1)
model MenuStock {
  id          String    @id @default(cuid())
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId  String
  packaging   Packaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  packagingId String
  qty         Int       @default(1)

  @@unique([menuItemId, packagingId])
}

model StockMovement {
  id            String    @id @default(cuid())
  packaging     Packaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  packagingId   String
  type          String // SALE | RESTOCK | IMPORT | ADJUST | VOID
  delta         Int
  before        Int
  after         Int
  note          String?
  userName      String?
  transactionId String? // untuk pembatalan/void
  createdAt     DateTime  @default(now())

  @@index([packagingId])
  @@index([createdAt])
  @@index([transactionId])
}

model Transaction {
  id           String            @id @default(cuid())
  code         String            @unique
  clientId     String?           @unique // UUID dari aplikasi HP → anti-dobel saat sinkron
  cashier      User              @relation(fields: [cashierId], references: [id])
  cashierId    String
  cashierName  String
  items        TransactionItem[]
  grossTotal   Int               @default(0) // sebelum diskon
  discount     Int               @default(0)
  voucherName  String?
  voucherId    String? // untuk kembalikan kuota saat void
  total        Int // setelah diskon (yang dibayar)
  costTotal    Int               @default(0)
  paid         Int
  change       Int               @default(0)
  payment      String            @default("TUNAI") // TUNAI | QRIS | TRANSFER | SPLIT
  payments     Json? // SPLIT: [{method, amount}] (jumlah = total). null = 1 metode (lihat lib/payments.ts)
  orderType    String            @default("DINEIN") // DINEIN | TAKEAWAY
  note         String?
  customerName String? // nama pelanggan (opsional, diketik kasir)
  orderCode    String? // kode order gaya barista, mis. "AB99" ([tglGanjil/Genap][shift][no urut harian])
  businessDate String
  shift        String? // nama shift saat trx dibuat (dinamis dari Setting shiftHours)
  status       String            @default("ACTIVE") // ACTIVE | VOID
  voidedAt     DateTime?
  voidedBy     String?
  voidReason   String?
  createdAt    DateTime          @default(now())

  @@index([businessDate])
  @@index([createdAt])
  @@index([cashierId])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  name          String
  category      String?
  price         Int // harga satuan termasuk tambahan varian
  cost          Int         @default(0)
  qty           Int
  subtotal      Int
  variants      String? // nama varian terpilih, mis. "Dingin, Double shot"
  note          String? // catatan per item (mis. "less sugar")
}

// Karyawan (lepas dari akun login — 3 orang bisa gantian pakai 1 akun kasir).
model Employee {
  id          String       @id @default(cuid())
  name        String       @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  attendances Attendance[]
}

model Attendance {
  id           String    @id @default(cuid())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  employeeName String
  businessDate String
  shift        String? // Sore | Malam | ...
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  recordedBy   String? // akun login yang mencatat
  note         String?

  @@index([businessDate])
  @@index([employeeId])
}

// Catatan keuangan / buku kas (pengeluaran beli barang, pemasukan manual).
model CashEntry {
  id           String   @id @default(cuid())
  type         String // MASUK | KELUAR
  amount       Int
  category     String   @default("LAINNYA")
  note         String?
  businessDate String
  userName     String?
  clientId     String?  @unique // idempotency dari HP (antre offline, retry aman)
  createdAt    DateTime @default(now())

  @@index([businessDate])
  @@index([createdAt])
}

model Voucher {
  id         String    @id @default(cuid())
  name       String    @unique
  type       String // PERCENT | NOMINAL
  value      Int // persen (0-100) atau rupiah
  active     Boolean   @default(true)
  maxUses    Int? // null = tak terbatas
  usedCount  Int       @default(0)
  validFrom  DateTime? // null = tak dibatasi
  validUntil DateTime? // null = tak dibatasi (disimpan akhir hari)
  createdAt  DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

// BIAYA OWNER (belanja bulanan, gaji karyawan, dll) — UANG OWNER, BUKAN DARI LACI.
// TIDAK membuat CashEntry — terpisah dari kas laci kasir.
model Purchase {
  id           String   @id @default(cuid())
  businessDate String
  category     String   @default("BELANJA") // BELANJA | GAJI | LAIN
  itemName     String
  qty          Int      @default(1)
  unit         String?
  unitPrice    Int // harga satuan
  total        Int
  note         String?
  notaName     String? // nama file nota
  notaUrl      String? // link Google Drive foto nota (di-share ke owner)
  userName     String?
  cashEntryId  String? // link ke CashEntry KELUAR yang dibuat otomatis
  createdAt    DateTime @default(now())

  @@index([businessDate])
}

// ================= DETEKSI PEMBAYARAN GOPAY (cabang Kaligondang) =================
// Tanpa payment gateway: HP MASTER (login GoPay Merchant) membaca notifikasi &
// riwayat GoPay lalu melapor ke server; server mencocokkan ke tagihan QR yang
// menunggu (kasir HP/tablet, kasir web, nanti self-order meja).

// Perangkat (HP/tablet) yang login aplikasi kasir. Admin memilih MASTER di web.
model Device {
  id            String   @id @default(cuid())
  deviceId      String   @unique // UUID dibuat aplikasi (tetap per instalasi)
  name          String // mis. "Xiaomi 24069PC21G"
  appVersion    String?
  userName      String? // akun login terakhir
  notifAccess   Boolean  @default(false) // izin baca notifikasi (lapis 1)
  historyAccess Boolean  @default(false) // izin aksesibilitas riwayat GoPay (lapis 2)
  hasGopay      Boolean  @default(false) // aplikasi GoPay Merchant terpasang
  isMaster      Boolean  @default(false) // pendeteksi pembayaran (maks 1)
  enabled       Boolean  @default(true) // dimatikan admin → laporan pembayaran ditolak
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
}

// Pembayaran GoPay yang dilaporkan HP master. Satu pembayaran bisa terlihat dari
// NOTIF (tanpa ref, presisi detik) DAN RIWAYAT (ref unik, presisi menit) →
// digabung (nominal sama, jam berdekatan) supaya tidak terhitung dobel.
model GopayPayment {
  id         String   @id @default(cuid())
  ref        String?  @unique // kode ref riwayat GoPay, mis. "AJDPID"
  notifKey   String?  @unique // id notif (anti dobel laporan ulang)
  amount     Int
  paidAt     DateTime
  hasNotif   Boolean  @default(false)
  hasHistory Boolean  @default(false)
  title      String?
  raw        String?
  deviceId   String?
  intentId   String?  @unique // tagihan yang dilunasi pembayaran ini
  createdAt  DateTime @default(now())

  @@index([amount, paidAt])
}

// Tagihan QRIS yang menunggu dibayar.
model PaymentIntent {
  id         String    @id @default(cuid())
  baseAmount Int // total tagihan asli
  amount     Int // yang harus dibayar = base + kode unik (kalau bentrok)
  uniqueCode Int       @default(0)
  label      String? // nama pelanggan / meja
  status     String    @default("PENDING") // PENDING | PAID | CANCELLED | EXPIRED
  source     String    @default("KASIR") // KASIR | WEB | MEJA
  paidVia    String? // NOTIF | HISTORY | MANUAL
  createdBy  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  paidAt     DateTime?
  paymentId  String?

  @@index([status, amount])
}
